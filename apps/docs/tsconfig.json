{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "rootDir": "src",
    "outDir": "../../.cache/tsc/docs",
    "tsBuildInfoFile": "../../.cache/tsc/docs.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/language"
    },
    {
      "path": "../../packages/i18n"
    },
    {
      "path": "../../packages/skin-contract"
    }
  ]
}
